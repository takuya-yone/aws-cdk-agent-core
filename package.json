{
  "name": "aws-cdk-agent-core",
  "version": "0.1.0",
  "bin": {
    "aws-cdk-agent-core": "bin/aws-cdk-agent-core.js"
  },
  "scripts": {
    "dev": "dotenvx run -f .env -- tsx watch src/lambda/apigw-router/local-index.ts",
    "build": "tsc --noEmit",
    "watch": "tsc --noEmit  -w",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "cdk": "cdk",
    "biome:dry": "biome check --unsafe bin lib src tests",
    "biome:fix": "biome check --write --unsafe bin lib src tests",
    "ruff:dry": "uv run ruff format --check src tools tests && uv run ruff check src tools tests",
    "ruff:fix": "uv run ruff format src tools tests && uv run ruff check src tools tests --fix",
    "prepare": "husky",
    "pytest": "uv run python -m pytest tests --cov"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@hono/node-server": "^2.1.5",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "aws-cdk": "2.1147.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-lambda-powertools/tracer": "^2.36.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1161.0",
    "@dotenvx/dotenvx": "^2.38.2",
    "@hono/standard-validator": "^0.4.1",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@middy/core": "^7.9.2",
    "aws-cdk-lib": "^2.275.0",
    "aws-lambda": "^1.0.7",
    "cdk-ecr-deployment": "^4.2.80",
    "constructs": "^10.8.1",
    "dynamoose": "^4.2.0",
    "hono": "^4.13.14",
    "nanoid": "^6.0.2",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.16.1"
}