{
  "name": "aws-cdk-agent-core",
  "version": "0.1.0",
  "bin": {
    "aws-cdk-agent-core": "bin/aws-cdk-agent-core.js"
  },
  "scripts": {
    "dev": "dotenvx run -f .env -- tsx watch src/lambda/apigw-router/local-index.ts",
    "build": "tsc --noEmit",
    "watch": "tsc --noEmit  -w",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "cdk": "cdk",
    "biome:dry": "biome check --unsafe bin lib src tests",
    "biome:fix": "biome check --write --unsafe bin lib src tests",
    "ruff:dry": "uv run ruff format --check src tools tests && uv run ruff check src tools tests",
    "ruff:fix": "uv run ruff format src tools tests && uv run ruff check src tools tests --fix",
    "prepare": "husky",
    "pytest": "uv run python -m pytest tests --cov"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@hono/node-server": "^2.1.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "aws-cdk": "2.1141.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-lambda-powertools/tracer": "^2.35.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1133.0",
    "@dotenvx/dotenvx": "^2.26.1",
    "@hono/standard-validator": "^0.4.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@middy/core": "^7.9.2",
    "aws-cdk-lib": "^2.269.0",
    "aws-lambda": "^1.0.7",
    "cdk-ecr-deployment": "^4.2.64",
    "constructs": "^10.8.1",
    "dynamoose": "^4.2.0",
    "hono": "^4.13.8",
    "nanoid": "^6.0.1",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@12.4.1"
}