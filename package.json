{
  "name": "aws-cdk-agent-core",
  "version": "0.1.0",
  "bin": {
    "aws-cdk-agent-core": "bin/aws-cdk-agent-core.js"
  },
  "scripts": {
    "dev": "dotenvx run -f .env -- tsx watch src/lambda/apigw-router/local-index.ts",
    "build": "tsc --noEmit",
    "watch": "tsc --noEmit  -w",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "cdk": "cdk",
    "biome:dry": "biome check --unsafe bin lib src tests",
    "biome:fix": "biome check --write --unsafe bin lib src tests",
    "ruff:dry": "uv run ruff format --check src tools tests && uv run ruff check src tools tests",
    "ruff:fix": "uv run ruff format src tools tests && uv run ruff check src tools tests --fix",
    "prepare": "husky",
    "pytest": "uv run python -m pytest tests --cov"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@hono/node-server": "^1.19.14",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.4",
    "aws-cdk": "2.1118.2",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@aws-cdk/aws-bedrock-agentcore-alpha": "2.250.0-alpha.0",
    "@aws-cdk/aws-bedrock-alpha": "2.250.0-alpha.0",
    "@aws-lambda-powertools/logger": "^2.33.0",
    "@aws-lambda-powertools/tracer": "^2.33.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1032.0",
    "@dotenvx/dotenvx": "^1.61.1",
    "@hono/standard-validator": "^0.2.2",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.3.0",
    "@middy/core": "^7.2.3",
    "aws-cdk-lib": "^2.250.0",
    "aws-lambda": "^1.0.7",
    "cdk-ecr-deployment": "^4.2.0",
    "constructs": "^10.6.0",
    "dynamoose": "^4.1.5",
    "hono": "^4.12.14",
    "nanoid": "^5.1.9",
    "rss-parser": "^3.13.0",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@10.33.0"
}
