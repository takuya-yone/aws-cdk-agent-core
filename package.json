{
  "name": "aws-cdk-agent-core",
  "version": "0.1.0",
  "bin": {
    "aws-cdk-agent-core": "bin/aws-cdk-agent-core.js"
  },
  "scripts": {
    "dev": "dotenvx run -f .env -- tsx watch src/lambda/apigw-router/local-index.ts",
    "build": "tsc --noEmit",
    "watch": "tsc --noEmit  -w",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "cdk": "cdk",
    "biome:dry": "biome check --unsafe bin lib src tests",
    "biome:fix": "biome check --write --unsafe bin lib src tests",
    "ruff:dry": "uv run ruff format --check src tools tests && uv run ruff check src tools tests",
    "ruff:fix": "uv run ruff format src tools tests && uv run ruff check src tools tests --fix",
    "prepare": "husky",
    "pytest": "uv run python -m pytest tests --cov"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@hono/node-server": "^2.1.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "aws-cdk": "2.1138.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-lambda-powertools/tracer": "^2.35.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1115.0",
    "@dotenvx/dotenvx": "^2.21.0",
    "@hono/standard-validator": "^0.4.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.1",
    "@middy/core": "^7.8.0",
    "aws-cdk-lib": "^2.266.0",
    "aws-lambda": "^1.0.7",
    "cdk-ecr-deployment": "^4.2.52",
    "constructs": "^10.8.1",
    "dynamoose": "^4.2.0",
    "hono": "^4.13.3",
    "nanoid": "^6.0.1",
    "rss-parser": "^3.13.0",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.22.0"
}